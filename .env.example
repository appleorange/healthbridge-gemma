# On-device AI (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b
# Increase for non-streaming calls on slower hardware (26B model needs 120000+)
OLLAMA_TIMEOUT_MS=120000

# App
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Healthcare.gov Marketplace API key — get your own at https://developer.cms.gov/marketplace-api/
# The default fallback is the CMS public demo key (rate-limited, for development only)
HEALTHCARE_GOV_API_KEY=a94d697d-5fe2-43d5-b829-fbf1d52d9c49
